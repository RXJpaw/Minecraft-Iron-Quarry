{
    "model": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "iron_quarry:blueprint_position",
        "on_true": {
            "type": "minecraft:model",
            "model": "iron_quarry:item/blueprint_written"
        },
        "on_false": {
            "type": "minecraft:select",
            "property": "minecraft:component",
            "component": "iron_quarry:blueprint_sealed",
            "cases": [
                {
                    "when": true,
                    "model": {
                        "type": "minecraft:model",
                        "model": "iron_quarry:item/blueprint_written"
                    }
                }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "iron_quarry:item/blueprint"
            }
        }
    }
}
